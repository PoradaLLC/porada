# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Anthropic — used by the admin pitch generator
ANTHROPIC_API_KEY=sk-ant-...

# Cron secret (Vercel sets this automatically in production)
CRON_SECRET=optional-random-string

# Meta Conversions API (server-side, never exposed to the client)
META_CAPI_TOKEN=your-meta-capi-access-token

# Note: the Google Analytics measurement ID and Meta Pixel ID are public client-side
# identifiers hardcoded in src/components/site/CookieConsent.tsx, where they load only
# after a visitor accepts cookies via the consent banner.
